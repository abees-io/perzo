# Copy this file to .env.local and fill in your NVIDIA API key.
# Never commit or share your real API key.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: override only if NVIDIA's Body Pose Try API page supplies a different function ID.
# Uses NVIDIA_API_KEY above; this is a separate gRPC video tool.
NVIDIA_BODY_POSE_FUNCTION_ID=254b3621-bb66-4b7b-9c89-621c352b4d91
